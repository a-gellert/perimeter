; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Perimeter"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameEnums="*res://scripts/core/game_enums.gd"
GameEvents="*res://scripts/core/game_events.gd"
InputInitializer="*res://scripts/core/input_initializer.gd"
WorldTopography="*res://scripts/world_zone_manager.gd"
ValleyEcology="*res://scripts/ecology_manager.gd"
EconomyManager="*res://scripts/economy_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
MonetizationManager="*res://scripts/core/monetization_manager.gd"
InventoryManager="*res://scripts/inventory/inventory_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="Environment"
3d_physics/layer_2="Player"
3d_physics/layer_3="Interactable"
3d_physics/layer_4="Building"
3d_physics/layer_5="Enemies"
3d_physics/layer_6="NPCs"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_bodies=65536
jolt_physics_3d/limits/max_body_pairs=131072

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
